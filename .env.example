# generate with: openssl rand -hex 32
AUTH_JWT_SECRET=
# generate with: openssl rand -hex 32
WS_TOKEN_SECRET=
# Sent as x-heyriz-internal-secret on every gateway call this server makes —
# must match the gateway's own AUTH_INTERNAL_SECRET, or every proxied
# dashboard request gets rejected. generate with: openssl rand -hex 32
AUTH_INTERNAL_SECRET=

# Origin of the backend gateway. tag.js derives both its HTTP origin and its
# WebSocket origin from this, so an http:// value gets the widget blocked as
# mixed content on any customer site served over HTTPS.
NEXT_PUBLIC_GATEWAY_URL=https://api.elpino.chat

# PostHog browser analytics (public configuration)
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# Firebase Web App config (public browser identifiers). In Firebase Console:
# Project settings → General → Your apps → Web app.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Optional. Every variable below can stay empty: the feature that uses it is
# simply off. Never commit real values.
# ---------------------------------------------------------------------------

# Public origin of this site, used for canonical URLs and sitemaps.
NEXT_PUBLIC_SITE_URL=

# Elpino's own chat widget on this site (the widget's public site key).
NEXT_PUBLIC_WIDGET_SITE_KEY=
# Server-side secrets that sign the identity of logged-in users to the widget.
# generate with: openssl rand -hex 32
ELPINO_IDENTITY_SECRET=
ELPINO_WIDGET_IDENTITY_SECRET=

# Transactional email (contact and careers forms).
RESEND_API_KEY=
RESEND_FROM=
CONTACT_EMAIL=
HIRING_EMAIL=

# Error reporting and analytics.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Integrations: Asana and LinkedIn OAuth, Telegram notifications, Giphy picker.
ASANA_REDIRECT_URI=
# Optional override; defaults to <site origin>/api/integrations/notion/callback.
NOTION_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_REDIRECT_URI=
LINKEDIN_SCOPES=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_GIPHY_API_KEY=

# Country lookup for visitor analytics.
GEOIP_LOOKUP_URL=
